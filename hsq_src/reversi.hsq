void setupGame()
{
  *board[27] = 79;
  *board[28] = 88;
  *board[35] = 88;
  *board[36] = 79;
}

void draw()
{
  puts(raw_data);
}

int isEmptyPosition(int num)
{
  //printf("isEmptyPosition %d\n", num);
  if(*board[num] == 46)
  {
    return 1;
  }
  return 0;
}

int isBlackPosition(int num)
{
  if(*board[num] == 88)
  {
    return 1;
  }
  return 0;
}

int isWhitePosition(int num)
{
  if(*board[num] == 79)
  {
    return 1;
  }
  return 0;
}

int isBoundary(int num, int arrow)
{
  //左方向の境界値チェック
  if(((num % 8) == 0) && (4 < arrow))
  {
    return 1;
  }
  //右方向の境界値チェック
  else if(((num % 8) == 7) && (arrow < 3))
  {
    return 1;
  }
  return 0;
}

int evaluate_direction(int isBlack, int num, int arrow)
{
  //printf("num : %d, arrow : %d\n", num, arrow);
  int reward = 0;

  if(isBoundary(num, arrow))
  {
    //debug_print("境界値に引っ掛かりました\n");
    return 0;
  }

  for(int i = num - direction[arrow]; (0 <= i) && (i < 64); i -= direction[arrow])
  {
    if(isEmptyPosition(i))
    {
        //debug_print("この先には何もないや\n");
        return 0;
    }
    if(isBlack)
    {
      if(isBlackPosition(i))
      {
        //debug_print("置けるかも\n");
        return reward;
      }
      else
      {
        //debug_print("ひっくり返せるかな。。");
        reward++;
      }
    }
    else
    {
      if(isWhitePosition(i))
      {
        //debug_print("置けるかも\n");
        return reward;
      }
      else
      {
        //debug_print("ひっくり返せるかな。。");
        reward++;
      }
    }// isBlack
    if(isBoundary(i, arrow))
    {
      //debug_print("境界値に引っ掛かりました\n");
      return 0;
    }
  }
  return 0;
}

int evaluate(int isBlack, int num)
{
  int reward = 0;

  for(int i = 0; i < 8; i++)
  {
    rewards[i] = evaluate_direction(isBlack, num, i);
    reward += rewards[i];
  }

  return reward;
}

int isValidPositionExist(int isBlack)
{
  if(turn_num < 8)
  {
    turn_num++;
    return 1;
  }
  for(int i = 0; i < 60; i++)
  {
    if(candidate[i] < 64)
    {
      if(evaluate(isBlack, candidate[i]))
      {
        turn_num++;
        return 1;
      }
    }
  }
  return 0;
}

int reverse(int isBlack, int num, int direction_num, int reward)
{
  for(int i = 0; i <= reward; i++)
  {
    if(isBlack)
    {
      *board[num] = 88;
    }
    else
    {
      *board[num] = 79;
    }
    num -= direction_num;
  }
}

void execute(int isBlack, int num)
{
  if(num < 64)
  {
    skip_count = 0;
    for(int i = 0; i < 8; i++)
    {
      //reward[i] が 0 の時は何もせず抜ける。
      reverse(isBlack, num, direction[i], rewards[i]);
    }
  }
}

int selectPosition(int isBlack)
{
  if(isBlack)
  {
    puts("X : 黒の番です");
  }
  else
  {
    puts("O : 白の番です");
  }

  if(!isValidPositionExist(isBlack))
  {
    puts("\n石を置ける場所が無いのでスキップします。");
    skip_count++;
    return 255;
  }

  while(1)
  {
    draw();
    puts("石を置く位置 : ");
    int x = getchar();
    int y = getchar();
    getchar();//drop pressed enter key.
    if((48 < y) && (y < 58) && (96 < x) && (x < 105))
    {
      printf("あなたが選んだ位置 : %c%c\n", x, y);
      int num = (y - 49) * 8 + (x - 97);
      if(isEmptyPosition(num))
      {
        if(evaluate(isBlack, num))
        {
          candidate[index_of_candidate[num]] = 255;
          return num;
        }
        else
        {
          puts("あなたはそこに石を置けません。\n");
          return -1;
        }
      }
      else
      {
        puts("そこは既に石が置いてあります。\n");
      }
    }
    else
    {
      printf("無効な座標です。もう一度選んでください\n");
      return -1;
    }
  }
}

int judge(int isBlack)
{
  int num = 0;
  int expectedVal = (isBlack)? 88 : 79;
  for(int i = 0; i < 64; i++)
  {
    if(*board[i] == expectedVal)
    {
      num++;
    }
  }
  return num;
}

void main()
{
  int num, black_reward = 0, white_reward = 0;
  int isBlack = 1;
  init();
  setupGame();
  while(turn_num < 60)
  {
    num = selectPosition(isBlack);
    if(num < 0)
    {
      return 0;
    }
    if(1 < skip_count)
    {
      break;
    }
    execute(isBlack, num);
    isBlack = 1 - isBlack;
  }

  black_reward = judge(1);
  white_reward = judge(0);
  printf("黒 : %d 枚、白 : %d 枚 \n", black_reward, white_reward);

  if(black_reward == white_reward)
  {
    puts("引き分け！！\n");
    draw();
  }
  else if(white_reward < black_reward)
  {
    puts("あなた（X : 黒）の勝ち！！\n");
    draw();
  }
  else
  {
    puts("あなた（X : 黒）の負け..\n");
    draw();
  }
}