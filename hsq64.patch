+// 値の2^64剰余(2の補数)を16進で出力する。10進文字列経由なので任意精度でも正しい
+static unsigned long long to_u64(const big::inumber &v)
+{
+	string s = v.str();
+	bool neg = (s.size() && s[0]=='-');
+	unsigned long long r = 0;
+	for( string::size_type k=(neg?1:0); k<s.size(); k++ )
+		r = r*10 + (unsigned long long)(s[k]-'0');
+	return neg ? (0ULL - r) : r;
+}
+
+string item::dumphex()
+{
+	if( state!=RES ) return "#"+s; // 未解決(この後エラーになる)
+	char buf[24];
+	std::sprintf(buf,"%llx",to_u64(i));
+	return buf;
+}
