+// .sqテキストを語列に読み込む。先頭行が'#'コメントなら64bit16進(新形式)、
+// そうでなければ従来の10進として解釈する。'#'行は常に読み飛ばす。
+static void sqloadtext(const string &text, vector<long long> &words)
+{
+	std::istringstream in(text);
+	string line;
+	bool first = true, hex = false;
+	while( std::getline(in,line) )
+	{
+		string::size_type p = line.find_first_not_of(" \t\r");
+		if( p==string::npos ) continue;
+		if( line[p]=='#' )
+		{
+			if( first ) hex = true;
+			first = false;
+			continue;
+		}
+		first = false;
+		std::istringstream ls(line);
+		string s;
+		while( ls>>s )
+		{
+			if( hex )
+			{
+				bool neg = (s[0]=='-');
+				unsigned long long u = std::strtoull(s.c_str()+(neg?1:0),0,16);
+				if( neg ) u = 0ULL - u;
+				words.push_back((long long)u);
+			}
+			else
+			{
+				words.push_back(ut::a2sq(s));
+			}
+		}
+	}
+}
